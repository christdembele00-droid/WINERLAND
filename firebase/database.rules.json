{
  "rules": {
    "rooms": {
      "$roomId": {
        "players": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "guilds": {
      "$guildId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('leaderId').val() === auth.uid) || (data.exists() && data.child('leaderId').val() === auth.uid))",
        "members": {
          "$uid": {
            ".write": "auth != null && ((data.exists() && data.child('role').val() === 'leader' && root.child('guilds').child($guildId).child('leaderId').val() === auth.uid) || (!data.exists() && root.child('guilds').child($guildId).child('leaderId').val() === auth.uid))"
          }
        }
      }
    },
    "guildWars": {
      "$warId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
